{
  "name": "screenstudio-agent",
  "version": "0.2.0",
  "description": "Drive Screen Studio from the command line so an AI agent can record and edit your screen — a verification-first fork of screenstudio-cli",
  "type": "module",
  "private": true,
  "bin": {
    "screenstudio": "./bin/screenstudio.js"
  },
  "files": [
    "bin/",
    "dist/",
    "skills/",
    "README.md",
    "README.zh-TW.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HyperfocuSam/screenstudio-agent.git"
  },
  "keywords": [
    "screen-studio",
    "screenstudio",
    "cli",
    "video-editing",
    "screen-recording",
    "cdp",
    "chrome-devtools-protocol",
    "automation",
    "ai-agent",
    "claude-code"
  ],
  "author": "Sam Wong",
  "contributors": [
    "Shawn Pana (original screenstudio-cli)"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=21.0.0"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
