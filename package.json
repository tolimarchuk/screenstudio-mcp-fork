{
  "name": "screenstudio-mcp",
  "version": "0.3.0",
  "description": "Unofficial Screen Studio 4 MCP with native desktop interaction and agent skills",
  "type": "module",
  "private": true,
  "bin": {
    "screenstudio-mcp": "./dist/mcp/main.js"
  },
  "files": [
    "dist/cdp/",
    "dist/mcp/",
    "dist/studio/",
    "native/Desktop.swift",
    "native/desktop-helper",
    "skills/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "build:native": "swiftc native/Desktop.swift -o native/desktop-helper -framework Cocoa -framework ApplicationServices",
    "test:live": "npm run build && node scripts/live-smoke.mjs",
    "check": "npm test && npm run build:native",
    "format:check": "prettier --check src/cdp src/studio src/mcp test scripts/*.mjs",
    "build:demo": "node scripts/build-demo.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tolimarchuk/screenstudio-mcp.git"
  },
  "keywords": [
    "screen-studio",
    "screenstudio",
    "cli",
    "video-editing",
    "screen-recording",
    "cdp",
    "chrome-devtools-protocol",
    "automation",
    "ai-agent",
    "claude-code"
  ],
  "author": "Sam Wong",
  "contributors": [
    "Shawn Pana (original screenstudio-cli)"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "commander": "^13.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "ws": "^8.22.0"
  }
}
